{
    "key": "group_offer_landing",
    "title": "Offer Landing Page",
    "fields": [
        {
            "key": "field_offer_headline",
            "label": "Hero Headline",
            "name": "offer_headline",
            "type": "text",
            "instructions": "The offer in one line. E.g. \"12 Months, Get 3 Free\"",
            "required": 1,
            "default_value": "12 Months, Get 3 Free",
            "placeholder": "e.g. 12 Months, Get 3 Free",
            "maxlength": 80
        },
        {
            "key": "field_offer_subline",
            "label": "Hero Subline",
            "name": "offer_subline",
            "type": "text",
            "instructions": "Supporting line under the headline. E.g. \"Total = 15 months. Pay for 12.\"",
            "required": 0,
            "default_value": "Total = 15 months. Pay for 12.",
            "placeholder": "e.g. Total = 15 months. Pay for 12.",
            "maxlength": 120
        },
        {
            "key": "field_offer_cta_text",
            "label": "CTA Button Text",
            "name": "offer_cta_text",
            "type": "text",
            "instructions": "Text for all CTA buttons on this page.",
            "required": 0,
            "default_value": "Get This Deal",
            "placeholder": "e.g. Get This Deal",
            "maxlength": 60
        },
        {
            "key": "field_offer_product",
            "label": "WooCommerce Product",
            "name": "offer_product",
            "type": "post_object",
            "instructions": "Select the WooCommerce product that will be added to cart when the visitor clicks any CTA button. The checkout URL will be built as: /checkout/?add-to-cart={product_id}",
            "required": 1,
            "post_type": [
                "product"
            ],
            "taxonomy": "",
            "return_format": "id",
            "multiple": 0,
            "allow_null": 0,
            "ui": 1,
            "ajax": 1
        },
        {
            "key": "field_offer_paid_months",
            "label": "Paid Months",
            "name": "offer_paid_months",
            "type": "number",
            "instructions": "Number of months the customer pays for. E.g. 12",
            "required": 1,
            "default_value": 12,
            "min": 1,
            "max": 24,
            "step": 1
        },
        {
            "key": "field_offer_free_months",
            "label": "Free Months (Bonus)",
            "name": "offer_free_months",
            "type": "number",
            "instructions": "Number of free bonus months. E.g. 3 (for '12 + 3 free' offer)",
            "required": 0,
            "default_value": 3,
            "min": 0,
            "max": 12,
            "step": 1
        },
        {
            "key": "field_offer_highlight_text",
