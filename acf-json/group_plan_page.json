{
    "key": "group_plan_page",
    "title": "Plan Page",
    "fields": [
        {
            "key": "field_plan_months",
            "label": "Plan Length",
            "name": "plan_months",
            "type": "select",
            "instructions": "The only required field. Prices, savings, checkout links, the compare table and the schema are all derived from it — set this and the page builds itself. Every other field below is an optional override.",
            "required": 1,
            "choices": {
                "1": "1 Month",
                "3": "3 Months",
                "6": "6 Months",
                "12": "12 Months"
            },
            "default_value": "1",
            "allow_null": 0,
            "multiple": 0,
            "ui": 1,
            "return_format": "value"
        },
        {
            "key": "field_plan_tab_hero",
            "label": "Hero",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_plan_eyebrow",
            "label": "Eyebrow",
            "name": "plan_eyebrow",
            "type": "text",
            "instructions": "Small pill above the headline. Leave empty for \"IPTV Subscription\".",
            "required": 0,
            "placeholder": "IPTV Subscription",
            "maxlength": 40
        },
        {
            "key": "field_plan_headline",
            "label": "Headline (H1)",
            "name": "plan_headline",
            "type": "text",
            "instructions": "Leave empty for \"{Plan Length} IPTV Subscription\", e.g. \"1 Month IPTV Subscription\". This is the page's H1 — write it for the search term you want.",
            "required": 0,
            "placeholder": "1 Month IPTV Subscription",
            "maxlength": 90
